{
  "name": "bluespoke/blue-spoke-api",
  "description": "Bike Shop API (PHP 8, PDO, JWT, PostgreSQL)",
  "type": "project",
  "require": {
    "phpunit/phpunit": "^10.5",
    "php": ">=8.1",
    "firebase/php-jwt": "^6.10",
    "ext-pdo": "*",
    "robmorgan/phinx": "^0.16.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Tests\\": "tests/"
    }
  },
  "config": {
    "process-timeout": 0
  },
  "scripts": {
    "start": "php -S 127.0.0.1:8080 -t public",
    "test": "php ./vendor/bin/phpunit --colors=always"
  }
}